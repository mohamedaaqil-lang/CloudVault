# CloudVault Backend Environment Configuration

# Flask Server Settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=cloudvault_secure_internship_secret_key_2026

# Firebase Admin SDK Configuration
# Option 1: Relative or absolute path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# Option 2: Full raw JSON string of service account (for Render / cloud deployments)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Firebase Cloud Storage Bucket Name (e.g. project-id.appspot.com or project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=cloudvault-system.appspot.com

# System Administrator Configuration (Comma-separated emails that automatically receive Admin role)
ADMIN_EMAILS=admin@cloudvault.edu,admin@example.com

# Upload constraints
MAX_UPLOAD_SIZE_MB=50
